{
  "manifest_version": 3,
  "name": "Claim Check",
  "description": "Investigate highlighted factual claims and inspect evidence.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "contextMenus",
    "sidePanel",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Claim Check"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "options_page": "options.html"
}
