DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
PROVIDER_MODE=
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
# Optional alternative search provider.
BRAVE_SEARCH_API_KEY=
CONTAINER_DATABASE_URL=
# Off by default. Enable only for a trusted localhost, single-process installation.
ALLOW_RUNTIME_PROVIDER_KEYS=false

# Optional model override; leave unset to use the evaluated default
# (MoritzLaurer/DeBERTa-v3-large-mnli-fever-anli-ling-wanli). See
# docs/final-configuration.md for why this model was selected.
NLI_MODEL=
